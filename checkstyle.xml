<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<module name="Checker">
  <module name="TreeWalker">

    <!-- Classes e Interfaces: PascalCase (ex: Filosofo, MesaDeJantar) -->
    <module name="TypeName">
      <property name="format" value="^[A-Z][a-zA-Z0-9]*$"/>
      <message key="name.invalidPattern" value="Nome da classe/interface ''{0}'' deve usar PascalCase."/>
    </module>

    <!-- Métodos e Variáveis Locais: camelCase (ex: pegarGarfo, tempoDeEspera) -->
    <module name="MethodName">
      <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
    </module>
    <module name="LocalVariableName">
      <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
    </module>

    <!-- Atributos de Classe: camelCase (ex: idFilosofo, garfoEsquerda) -->
    <module name="MemberName">
      <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
    </module>

    <!-- Constantes: UPPER_SNAKE_CASE (ex: TEMPO_MAXIMO, NUM_FILOSOFOS) -->
    <module name="ConstantName">
      <property name="format" value="^[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$"/>
    </module>

  </module>
</module>